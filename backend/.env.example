# 基础配置
ENV=dev
DEBUG=true
LOG_LEVEL=INFO

# 服务器
HOST=0.0.0.0
PORT=8000

# 数据库 (SQLite 默认)
DATABASE_URL=sqlite:///./data.db

# JWT
# 生成强随机密钥: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 文件上传
MAX_UPLOAD_SIZE=524288000

# 文件即知识库配置
MAX_FILE_CONTENT_LENGTH=80000
MAX_FILES_PER_CHAT=5

# LLM 配置（任意 OpenAI 兼容服务商）
# 预设: deepseek, kimi, qwen, zhipu, minimax, openai；其他可用 LLM_BASE_URL 自定义
LLM_PROVIDER=deepseek
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Kimi（月之暗面）示例
# LLM_PROVIDER=kimi
# LLM_API_KEY=sk-xxx
# LLM_MODEL=kimi-k2-0905-preview

# 通义千问示例
# LLM_PROVIDER=qwen
# LLM_API_KEY=sk-xxx
# LLM_MODEL=qwen-plus

# 智谱 GLM 示例
# LLM_PROVIDER=zhipu
# LLM_API_KEY=xxx.xxx
# LLM_MODEL=glm-4-plus

# 备选模型（选填；主模型请求失败时自动切换一次）
# LLM_FALLBACK_PROVIDER=kimi
# LLM_FALLBACK_API_KEY=sk-xxx
# LLM_FALLBACK_MODEL=kimi-k2-0905-preview
# LLM_FALLBACK_BASE_URL=  # 留空则按 provider 预设

# DeepSeek 示例
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# MiniMax 示例
# LLM_PROVIDER=minimax
# LLM_API_KEY=xxx
# LLM_BASE_URL=https://api.minimax.chat/v1
# LLM_MODEL=abab6.5-chat
